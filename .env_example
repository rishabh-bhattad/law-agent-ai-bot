# .env
PROJECT_NAME="Live Case-Law Briefing Bot"
DEBUG=True

# LLM Provider - 'gemini' or 'anthropic' or 'openai'
LLM_PROVIDER="gemini"
LLM_MODEL_FAST="gemini-3.5-flash-lite"
LLM_MODEL_REASONING="gemini-3.5-flash"

# API Keys - Set the key
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

COURTLISTENER_API_KEY="your_courtlistener_api_key_here"